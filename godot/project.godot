; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Lighthouse Keepers"
; Exported release builds block-buffer stdout, so a short run loses whatever
; has not filled a 4KB block, silently truncating both harness logs and anything
; a playtester would paste back. Flushing per print costs nothing at this volume.
run/flush_stdout_on_print=true
run/main_scene="uid://blighthousekeeperboot"
config/features=PackedStringArray("4.6")

[autoload]

Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
EventBus="*res://autoload/event_bus.gd"
Tuning="*res://autoload/tuning.gd"
Net="*res://autoload/net.gd"
WorldState="*res://autoload/world_state.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

