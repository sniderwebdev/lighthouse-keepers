; Godot 4 project file — Lighthouse Keepers scaffold.
; Minimal config; the important part is the autoload singletons that form the
; co-op architecture spine (event bus, networking, authoritative-state mirror).

config_version=5

[application]
config/name="Lighthouse Keepers"
config/features=PackedStringArray("4.3")

[autoload]
; Order matters: EventBus has no deps; Net depends on nothing at load;
; WorldState listens to Net + EventBus.
EventBus="*res://autoload/event_bus.gd"
Net="*res://autoload/net.gd"
WorldState="*res://autoload/world_state.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]
textures/canvas_textures/default_texture_filter=0

[input]
; Controller-first (CLAUDE.md). Device 0 = keeper picked at session start,
; device 1 = the other keeper (couch). Keyboard bindings are the adaptation.
move_left={"deadzone":0.3,"events":[{"type":"joypad_motion","device":0,"axis":0,"axis_value":-1.0},{"type":"key","keycode":65}]}
move_right={"deadzone":0.3,"events":[{"type":"joypad_motion","device":0,"axis":0,"axis_value":1.0},{"type":"key","keycode":68}]}
move_up={"deadzone":0.3,"events":[{"type":"joypad_motion","device":0,"axis":1,"axis_value":-1.0},{"type":"key","keycode":87}]}
move_down={"deadzone":0.3,"events":[{"type":"joypad_motion","device":0,"axis":1,"axis_value":1.0},{"type":"key","keycode":83}]}
interact={"deadzone":0.5,"events":[{"type":"joypad_button","device":0,"button_index":0},{"type":"key","keycode":69}]}
cancel={"deadzone":0.5,"events":[{"type":"joypad_button","device":0,"button_index":1},{"type":"key","keycode":4194305}]}
use_tool={"deadzone":0.5,"events":[{"type":"joypad_button","device":0,"button_index":2},{"type":"key","keycode":81}]}
menu_radial={"deadzone":0.5,"events":[{"type":"joypad_button","device":0,"button_index":3},{"type":"key","keycode":4194306}]}
menu_pause={"deadzone":0.5,"events":[{"type":"joypad_button","device":0,"button_index":6},{"type":"key","keycode":4194332}]}
p2_move_left={"deadzone":0.3,"events":[{"type":"joypad_motion","device":1,"axis":0,"axis_value":-1.0}]}
p2_move_right={"deadzone":0.3,"events":[{"type":"joypad_motion","device":1,"axis":0,"axis_value":1.0}]}
p2_move_up={"deadzone":0.3,"events":[{"type":"joypad_motion","device":1,"axis":1,"axis_value":-1.0}]}
p2_move_down={"deadzone":0.3,"events":[{"type":"joypad_motion","device":1,"axis":1,"axis_value":1.0}]}
p2_interact={"deadzone":0.5,"events":[{"type":"joypad_button","device":1,"button_index":0}]}
p2_cancel={"deadzone":0.5,"events":[{"type":"joypad_button","device":1,"button_index":1}]}
p2_use_tool={"deadzone":0.5,"events":[{"type":"joypad_button","device":1,"button_index":2}]}
p2_menu_radial={"deadzone":0.5,"events":[{"type":"joypad_button","device":1,"button_index":3}]}
