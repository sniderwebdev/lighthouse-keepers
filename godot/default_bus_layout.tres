[gd_resource type="AudioBusLayout" format=3]

; Four buses, which is the whole mixer (PLAN.md M10: "No audio middleware").
; Master, then Ambience / Music / SFX so the settings sliders have one thing each
; to move and the mix has one place to be wrong.
;
; Music sits under ambience by default (-6 dB against ambience's -3). The spec
; for this game is cozy, and a dusk theme that competes with the sea is not.

[resource]
bus/0/volume_db = 0.0
bus/1/name = &"Ambience"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = -3.0
bus/1/send = &"Master"
bus/2/name = &"Music"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = -6.0
bus/2/send = &"Master"
bus/3/name = &"SFX"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = -1.0
bus/3/send = &"Master"
